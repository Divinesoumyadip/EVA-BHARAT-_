# Copy to .env for local use with a tool like `direnv` or export manually.
# The server itself reads these from the process environment - it does not
# load .env files automatically.

# Port the HTTP server listens on.
PORT=8080

# PostgreSQL connection string.
# Local example (matches docker-compose.yml):
DATABASE_URL=postgres://eva:eva_dev_pw@localhost:5432/eva_media?sslmode=disable

# Origin allowed to make CORS requests to the API - the deployed frontend's
# URL in production, or the Vite dev server locally. Use "*" only for quick
# local demos.
ALLOWED_ORIGIN=http://localhost:5173
